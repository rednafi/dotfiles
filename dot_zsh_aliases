# -*- mode: shell-script -*-
##########################################
# Aliases
##########################################

unalias ,brclr ,clear-junk ,docker-prune-containers ,docker-prune-images \
    ,docker-prune-volumes ,docker-nuke cat python tk jetbox 2>/dev/null

# Git: Clear branches except current, 'main', 'master', 'staging', 'development'.
,brclr() {
    local current branch

    current="$(git branch --show-current 2>/dev/null)" || return
    git branch --format='%(refname:short)' 2>/dev/null |
        while IFS= read -r branch; do
            case "$branch" in
                "$current"|main|master|staging|development) continue ;;
            esac
            git branch -D "$branch"
        done
}

## Unix
alias sudo="sudo "
alias cp="cp -iv"
alias mv="mv -iv"
alias rm="rm -iv"

if ls --color=auto -d . >/dev/null 2>&1; then
    alias ls="ls --color=auto"
else
    alias ls="ls -G"
fi

command -v bat >/dev/null 2>&1 && alias cat="bat"
command -v python3.14 >/dev/null 2>&1 && alias python="python3.14"


# Docker
_docker_available() {
    command -v docker >/dev/null 2>&1
}

,docker-prune-containers() {
    _docker_available || return 0

    local containers
    containers=("${(@f)$(docker ps -aq 2>/dev/null)}")
    (( ${#containers[@]} )) || return 0

    docker stop "${containers[@]}" 2>/dev/null || true
    docker rm "${containers[@]}" 2>/dev/null || true
}

,docker-prune-images() {
    _docker_available || return 0

    local images
    images=("${(@f)$(docker images -q 2>/dev/null)}")
    (( ${#images[@]} )) || return 0

    docker rmi --force "${images[@]}" || true
}

,docker-prune-volumes() {
    _docker_available || return 0
    docker system prune -af --volumes
}

,docker-nuke() {
    ,docker-prune-containers
    ,docker-prune-images
    ,docker-prune-volumes
}


# Doordash / wolt
command -v tsh >/dev/null 2>&1 && alias tk="tsh kubectl"
[[ -x "$HOME/.local/bin/jetbox" ]] && alias jetbox="$HOME/.local/bin/jetbox"

# Misc
,clear-junk() {
    local dir profile free_before free_after reclaimed cleaned
    local -a dirs=(
        "$HOME/Library/Caches"
        "$HOME/Library/Logs"
        "$HOME/.Trash"
        "$HOME/.cache"
        "$HOME/.npm"
        "$HOME/.nvm/.cache"
        "$HOME/Library/pnpm/store"
        "$HOME/.cargo/registry/cache"
        "$HOME/.cargo/registry/index"
        "$HOME/.cargo/registry/src"
        "$HOME/.cargo/git/checkouts"
        "$HOME/.cargo/git/db"
        "$HOME/.rustup/downloads"
        "$HOME/.rustup/tmp"
        "$HOME/Library/Application Support/virtualenv"
        "$HOME/Library/Application Support/MobileSync/Backup"
        "$HOME/Library/Application Support/Google/Chrome/OptGuideOnDeviceModel"
        "$HOME/Library/Application Support/Google/Chrome/optimization_guide_model_store"
        "$HOME/Library/Application Support/Google/Chrome/extensions_crx_cache"
        "$HOME/Library/Application Support/Google/Chrome/component_crx_cache"
        "$HOME/Library/Application Support/Google/GoogleUpdater/crx_cache"
        "$HOME/Library/Application Support/Slack/Cache"
        "$HOME/Library/Application Support/Slack/Service Worker/CacheStorage"
        "$HOME/Library/Application Support/Code/Cache"
        "$HOME/Library/Application Support/Code/CachedData"
        "$HOME/Library/Application Support/Code/CachedExtensionVSIXs"
        "$HOME/Library/Application Support/Code/CachedExtensions"
        "$HOME/Library/Application Support/Code/Service Worker/CacheStorage"
        "$HOME/Library/Application Support/Code/Service Worker/ScriptCache"
        "$HOME/Library/Application Support/Code/GPUCache"
        "$HOME/Library/Application Support/Zed/node/cache"
        "$HOME/Library/Developer/Xcode/DerivedData"
    )

    # The approximate delta assumes these targets share $HOME's APFS volume;
    # unrelated writes or cleanup on that volume can also affect the result.
    free_before="$(df -k "$HOME" | awk 'NR == 2 { print $4 }')"

    for profile in "$HOME/Library/Application Support/Google/Chrome"/{Default,Profile\ *}(N/); do
        dirs+=(
            "$profile/Service Worker/CacheStorage"
            "$profile/GPUCache"
            "$profile/ShaderCache"
            "$profile/Crash Reports"
        )
    done

    # Keep all privileged work in one process so sudo prompts exactly once.
    sudo /bin/zsh -c '
        echo "Clearing user and application caches..."
        for dir in "$@"; do
            [[ -d "$dir" ]] || continue
            /usr/bin/find "$dir" -mindepth 1 -maxdepth 1 \
                -exec /bin/rm -rf {} + 2>/dev/null
        done

        echo "Clearing system caches and old temporary files..."
        /usr/bin/find /Library/Caches -mindepth 1 -maxdepth 1 \
            -exec /bin/rm -rf {} + 2>/dev/null
        /usr/bin/find /var/tmp -mindepth 1 -mtime +7 \
            -exec /bin/rm -rf {} + 2>/dev/null
        /usr/bin/tmutil deletelocalsnapshots / 2>/dev/null
    ' clear-junk "${dirs[@]}" || return 1

    echo "Clearing development caches..."
    command -v uv >/dev/null 2>&1 && uv cache clean >/dev/null 2>&1
    command -v pip3 >/dev/null 2>&1 && pip3 cache purge >/dev/null 2>&1
    if command -v go >/dev/null 2>&1; then
        go clean -cache -testcache >/dev/null 2>&1
        go clean -modcache >/dev/null 2>&1
    fi
    command -v npm >/dev/null 2>&1 && npm cache clean --force >/dev/null 2>&1
    command -v yarn >/dev/null 2>&1 && yarn cache clean >/dev/null 2>&1
    command -v brew >/dev/null 2>&1 && brew cleanup --prune=all >/dev/null 2>&1
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        docker system prune -af >/dev/null 2>&1
    fi
    command -v xcrun >/dev/null 2>&1 && xcrun simctl delete unavailable >/dev/null 2>&1

    qlmanage -r cache >/dev/null 2>&1

    free_after="$(df -k "$HOME" | awk 'NR == 2 { print $4 }')"
    reclaimed=$(( free_after - free_before ))
    (( reclaimed < 0 )) && reclaimed=0
    cleaned="$(awk -v kib="$reclaimed" 'BEGIN {
        split("KiB MiB GiB TiB", units)
        value = kib
        unit = 1
        while (value >= 1024 && unit < 4) {
            value /= 1024
            unit++
        }
        printf "%.1f %s", value, units[unit]
    }')"
    echo "Done! Reclaimed approximately $cleaned. 🧹"
}

