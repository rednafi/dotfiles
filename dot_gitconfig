[includeIf "gitdir:~/canvas/pers/"]
	path = ~/.gitconfig-pers

[includeIf "gitdir:~/canvas/werk/"]
	path = ~/.gitconfig-werk
[core]
	editor = micro
[sequence]
	editor = micro
[diff]
	tool = zed
	algorithm = histogram
[difftool]
	prompt = false
[difftool "zed"]
	cmd = zed --wait --diff "$LOCAL" "$REMOTE"
[merge]
	tool = vimdiff
[mergetool]
	prompt = false
	keepBackup = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
